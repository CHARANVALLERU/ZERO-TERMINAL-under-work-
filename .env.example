# ZERO — example environment (copy to .env and fill in; never commit secrets)
# AITE reads these via os.environ (engine/aite/config.py). Dotenv is optional.

# ── Gemini (optional — AGI / debate work offline without a key) ──────────────
# GEMINI_API_KEY=

# ── ZERO AITE ────────────────────────────────────────────────────────────────
# Paper fund size in INR (default ₹10,00,000)
# ZERO_AITE_PAPER_FUND=1000000

# Target survivor count in the live book (clamped to 10–40)
# ZERO_AITE_TARGET_BOTS=20

# Opt-in MetaTrader 5 paper path (0=local sim only, 1=try MT5 when installed)
# ZERO_AITE_MT5=0

# India broker Market Watch names — must match MT5 exactly (not yfinance).
# ZERO UI label "NIFTY 50" maps through either of these (first set wins):
# ZERO_AITE_MT5_NIFTY=NIFTY
# ZERO_AITE_MT5_NIFTY50=NIFTY50
# ZERO_AITE_MT5_BANKNIFTY=BANKNIFTY
# ZERO_AITE_MT5_SENSEX=SENSEX

# ── Broker live gate (separate from AITE MT5 paper) ──────────────────────────
# ZERO_BROKER_ARMED=0

# ── Hugging Face (optional — higher Hub rate limits for Kronos weights) ──────
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
